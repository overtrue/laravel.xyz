---
import type { ChallengeId } from '../data/challenges';
interface Props { id: ChallengeId }
const { id } = Astro.props;
---
<svg class="orbit-stamp" data-stamp-art={id} viewBox="0 0 80 80" fill="none" aria-hidden="true" focusable="false">
  <path class="stock" d="M7 12H20l5-5h43l6 6v48L62 73H12l-6-6V19z"/>
  <path class="stamp-rim" d="M11 17h11l5-5h39l3 4v43L60 68H15l-4-4z"/>
  <g stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    {id === 'blade' && <><path d="M23 23h23l11 11v25H23zM46 23v11h11"/><path d="m33 39-5 5 5 4m14-9 5 5-5 4m-6-11-4 14"/></>}
    {id === 'artisan' && <><path d="M18 25h43v32H18zM18 33h43"/><path d="m27 40 6 5-6 5m13 0h11"/><path d="M24 29h1m5 0h1" stroke-width="1.4"/></>}
    {id === 'validation' && <><path d="m38 21 17 7v12c0 10-9 17-17 21-8-4-17-11-17-21V28z"/><path d="m30 41 5 5 10-12"/><path d="M56 45h8m-4-4v8"/></>}
    {id === 'queues' && <><path d="M21 28h27M21 39h18M21 50h13"/><circle cx="50" cy="46" r="12"/><path d="M50 39v8l5 2"/></>}
  </g>
  <g class="stamp-marks" stroke="currentColor"><path d="M17 16v3m4-3v3m4-3v3m31 43v4m4-4v4m4-4v3"/></g>
</svg>
<style>
  .orbit-stamp { display:block; width:100%; height:auto; color:var(--stamp-ink,#665292); }
  [data-stamp-art="blade"] { --stamp-ink:#5b458e; --stamp-fill:#e1d7ff; }
  [data-stamp-art="artisan"] { --stamp-ink:#943b28; --stamp-fill:#ffd8c8; }
  [data-stamp-art="validation"] { --stamp-ink:#34548f; --stamp-fill:#d8e6ff; }
  [data-stamp-art="queues"] { --stamp-ink:#286651; --stamp-fill:#d2ecdc; }
  .stock { fill:var(--stamp-fill); stroke:currentColor; stroke-width:1.3; }
  .stamp-rim,.stamp-marks { stroke:currentColor; opacity:.52; stroke-width:.8; }
</style>
