---
import Icon from './Icon.astro';
import { profileFor } from '../data/community';
import { getLocale, localize } from '../lib/locale';
interface Props { handle: string; name: string }
const { handle, name } = Astro.props;
const { t } = localize(getLocale(Astro.url.pathname));
const profile = profileFor(handle);
const profileLabel = name + ' · GitHub';
const siteLabel = t('Website linked by ', '个人网站 · ') + name;
---
<span class="socials">
  <a href={'https://github.com/' + profile.github} aria-label={profileLabel} title={profileLabel}>
    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38l-.01-1.49c-2.23.49-2.7-1.08-2.7-1.08-.37-.93-.9-1.18-.9-1.18-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.72 1.23 1.88.87 2.34.67.07-.52.28-.87.51-1.07-1.78-.2-3.65-.89-3.65-3.96 0-.88.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.22 2.2.82A7.67 7.67 0 0 1 8 3.72c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.08-1.88 3.76-3.67 3.96.29.25.55.74.55 1.49l-.01 2.32c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"/></svg>
  </a>
  {profile.x && <a href={'https://x.com/' + profile.x} aria-label={name + ' · X'} title={name + ' · X'}><svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.55" aria-hidden="true"><path d="M3 3h3.7L17 17h-3.7ZM16 3l-5.5 6.2M9 11l-6 6"/></svg></a>}
  {profile.site && <a href={profile.site} aria-label={siteLabel} title={siteLabel}><Icon name="globe" size={16}/></a>}
</span>
<style>
  .socials { display:inline-flex; align-items:center; gap:1px; }
  .socials a { display:grid; place-items:center; width:34px; height:34px; color:var(--muted); }
  .socials a:is(:hover,:focus-visible) { color:var(--accent); background:var(--accent-wash); }
</style>
