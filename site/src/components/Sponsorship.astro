---
import Icon from './Icon.astro';
import { sponsor } from '../lib/site';
import { getLocale, localize } from '../lib/locale';
const { t } = localize(getLocale(Astro.url.pathname));
---
<aside class="support" aria-label={t('Community sponsorship','社区赞助')}>
  <svg viewBox="0 0 68 62" width="62" height="57" fill="none" aria-hidden="true">
    <path d="M5 40h12v12h13m16-43h14v13M7 12h8m-4-4v8" stroke="#be8178" stroke-width="1.5"/>
    <path d="M34 46 17 30c-12-13 5-27 17-14 12-13 29 1 17 14z" fill="#ffbeaa" stroke="#973d37" stroke-width="2"/>
    <path d="M34 37 23 27c-5-6 2-13 7-7l4 4 4-4c5-6 12 1 7 7z" stroke="#973d37" stroke-width="1.4"/>
  </svg>
  <div><h2>{t('Support the maintainer','支持维护者')}</h2><p>{t('Enjoy the free courses and tools? Sponsor overtrue on GitHub.','如果免费课程和工具帮到了你，可以在 GitHub 上赞助 overtrue。')}</p></div>
  <a href={sponsor} class="sponsor-button">{t('GitHub Sponsors','去 GitHub 赞助')}<Icon name="external" size={16}/></a>
</aside>
<style>
.support { display:flex; align-items:center; gap:clamp(12px,2vw,28px); padding:clamp(17px,2.5vw,32px); margin-top:clamp(32px,5vw,66px); border-block:1px solid #e4cfc7; background:#fbf1eb; color:#332624; }
.support h2 { margin:0; font:560 clamp(1.28rem,2.1vw,1.95rem)/1.2 var(--display); letter-spacing:-.036em; }
.support p { margin:5px 0 0; color:#654f4a; font-size:.91rem; line-height:1.55; }
.sponsor-button { display:inline-flex; gap:7px; align-items:center; flex:none; margin-left:auto; padding:9px 13px; min-height:40px; color:#71372d; background:#fffaf6; border:1px solid #c79d92; border-radius:4px; font-size:.85rem; font-weight:600; }
.sponsor-button:hover { background:#ffe2d6; }
@media(max-width:650px) { .support { display:grid; grid-template-columns:auto minmax(0,1fr); gap:8px 14px; } .support>svg { width:44px; height:auto; align-self:start; } .sponsor-button { grid-column:2; margin:0; justify-self:start; } }
</style>
