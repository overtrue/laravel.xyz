---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { courses, coursePath, type CourseId } from '../../data/courses';
import { quizzes, quizKey, quizStops } from '../../data/quizzes';
import { getCourses } from '../../lib/site';
import { getLocale, localize } from '../../lib/locale';
import { passCount, points, questionCount } from '../../lib/quiz-score';
import '../../styles/quiz.css';

export function getStaticPaths() { return courses.map(({id}) => ({params:{id},props:{id}})); }
interface Props { id:CourseId }
const {id} = Astro.props;
const {locale,t,href} = localize(getLocale(Astro.url.pathname));
const course = (await getCourses(locale)).find(course => course.id === id)!;
const questions = quizzes[id];
const stops = quizStops(locale);
const title = t('Challenge · ','闯关 · ') + stops.find(stop => stop.id === id)!.title;
const description = t('Test what you learned in ', '用实战题检验所学 · ') + course.title;
const lessonTitle = (slug:string) => course.lessons.find(lesson => lesson.id === slug)!.data.title;
const review = [...new Set(questions.map(q => q.lesson))];
---
<Base {title} {description}>
  <div class="shell quiz-page" data-quiz={id} data-key={quizKey(id)} data-stops={JSON.stringify(stops)}>
    <nav class="breadcrumbs" aria-label={t('Breadcrumb','面包屑')}><a href={href('/courses/')}>{t('Free courses','免费课程')}</a><Icon name="chevron" size={15}/><a href={href('/challenges/')}>{t('Course challenges','课程闯关')}</a></nav>
    <header class="quiz-heading"><h1>{stops.find(stop => stop.id === id)!.title}<em>.</em></h1><p>{t('Answer '+passCount+' of '+questionCount+' correctly to clear this round.','共 '+questionCount+' 题，答对 '+passCount+' 题即可过关。')}</p></header>
    <div class="quiz-board">
      <aside class="quiz-meter" aria-label={t('Round progress','本轮进度')}>
        <div class="meter-heading"><Icon name="flag" size={17}/>{t('Round score','本轮得分')}</div>
        <p class="meter-number"><b data-round-score>0</b><span>/ 100</span></p>
        <svg class="meter-art" viewBox="0 0 224 110" fill="none" aria-hidden="true">
          <path d="M8 101H217" stroke="#7e728e" stroke-dasharray="2 5"/>
          <path d="M15 94V80h49V62h49V44h49V26h45v68z" fill="#433b52" stroke="#9586a4"/>
          {[0,1,2,3].map(i => <g data-signal={i}>
            <path d={'M'+(16+i*49)+' '+(81-i*18)+'h'+(i===3?43:48)+'v'+(12+i*18)+'h-'+(i===3?43:48)+'z'} class="step-fill"/>
            <circle cx={38+i*49} cy={69-i*18} r="5" class="step-light"/>
          </g>)}
          <path d="M195 25V2" stroke="#edce9e" stroke-width="1.5"/><path d="M195 2h18l-5 4 5 4h-18z" fill="#ffd48b"/>
        </svg>
        <p class="meter-best"><span>{t('Personal best','个人最高')}</span><b data-personal-best>—</b></p>
        <a class="meter-course" href={href(coursePath(id))}>{t('Course lessons','回到课程')} <Icon name="right" size={14}/></a>
      </aside>
      <div class="quiz-play" data-play hidden>
        {questions.map((q,index) => <section class="quiz-question" data-question={index} hidden aria-labelledby={'question-'+index}>
          <span class="quiz-counter">{t('Question','第')} {index+1} / {questions.length} {t('','题')}</span>
          <h2 tabindex="-1" id={'question-'+index}>{q.prompt[locale]}</h2>
          {q.code && <pre class="quiz-code"><code>{q.code}</code></pre>}
          {q.hint && <details class="quiz-hint"><summary>{t('Give me a hint','看个提示')}</summary><p>{q.hint[locale]}</p></details>}
          <form>
            <fieldset class="quiz-choices"><legend class="sr-only">{q.prompt[locale]}</legend>
              {q.choices.map((choice, option) => <label><input type="radio" name={'answer-'+index} value={option}/><span>{choice[locale]}</span><small data-choice-note></small></label>)}
            </fieldset>
            <button class="button quiz-submit" type="submit" disabled>{t('Check answer','确认答案')}<Icon name="check" size={16}/></button>
          </form>
          <div class="quiz-feedback" data-explanation hidden><h3 tabindex="-1"></h3><p>{q.why[locale]}</p><a class="text-link" href={href('/learn/'+q.lesson+'/')}>{t('Review the lesson','回看这节课')} <Icon name="right" size={14}/></a></div>
          <button class="button quiz-next" type="button" data-advance hidden>{index+1 === questions.length ? t('See my result','查看成绩') : t('Next question','下一题')}<Icon name="right" size={16}/></button>
        </section>)}
        <section class="quiz-result" data-result-screen hidden aria-labelledby="result-title">
          <span class="quiz-counter">{t('Round result','本轮成绩')}</span>
          <h2 tabindex="-1" id="result-title"></h2><p data-result-detail></p>
          <section class="quiz-review" data-review hidden><h3>{t('Revisit the missed topics','复习本轮错题')}</h3><ul role="list">
            {review.map(slug => <li data-review-for={questions.flatMap((q,i) => q.lesson === slug ? [i] : []).join(' ')}><a href={href('/learn/'+slug+'/')}><Icon name="book" size={16}/>{lessonTitle(slug)}<Icon name="right" size={14}/></a></li>)}
          </ul></section>
          <p data-save-warning hidden>{t('This browser could not save your score.','当前浏览器无法保存此次成绩。')}</p>
          <div class="result-actions"><a class="button quiz-next" data-next-round href={href('/challenges/')}><span></span><Icon name="right" size={16}/></a><button class="button" type="button" data-replay>{t('Play again','再闯一次')}</button></div>
          <a class="text-link" href={href('/orbit/')+'#quiz-record'}>{t('My challenge record','我的闯关战绩')} <Icon name="right" size={14}/></a>
        </section>
      </div>
      <noscript><section class="quiz-paper"><h2>{t('Practice questions','自测题')}</h2><p>{t('Enable JavaScript for scoring, or check the answers below.','启用 JavaScript 即可计分，也可以在下方自测核对。')}</p>
        {questions.map(q => <details><summary>{q.prompt[locale]}</summary>{q.code && <pre class="quiz-code"><code>{q.code}</code></pre>}<p><strong>{q.choices[q.correct][locale]}</strong></p><p>{q.why[locale]}</p><a class="text-link" href={href('/learn/'+q.lesson+'/')}>{lessonTitle(q.lesson)}</a></details>)}
      </section></noscript>
    </div>
    <p class="quiz-rules"><Icon name="test" size={16}/>{t('Each answer is worth '+points(1)+' points. Replays keep your highest score.','每题 '+points(1)+' 分。可以反复挑战，战绩保留最高分。')}</p>
  </div>
</Base>
<script src="../../scripts/quiz-round.ts"></script>
