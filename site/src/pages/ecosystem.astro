---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SaveButton from '../components/SaveButton.astro';
import QuickLab from '../components/QuickLab.astro';
import DirectoryCover from '../components/DirectoryCover.astro';
import { getEcosystem, getOpenSourceProjects } from '../data/ecosystem';
import { getLocale, localize } from '../lib/locale';

const { locale, t, href } = localize(getLocale(Astro.url.pathname));
const topics = getEcosystem(locale);
const projects = getOpenSourceProjects(locale);
const title = t('Laravel ecosystem', 'Laravel 生态选型');
const description = t('Choose tools for your project, then see how others use them in real Laravel apps.', '按项目需求选工具，再去真实的 Laravel 应用里读一段源码。');
const topicGlyph = { setup:'terminal',frontend:'layers',data:'api',async:'flow',quality:'test',production:'deploy' } as const;
const furtherReading = [
  { title: 'Awesome Laravel', url: 'https://github.com/chiraggude/awesome-laravel', description: t('A broad list of packages, tutorials, and community resources.', '涵盖扩展包、教程和社区资源的综合清单。') },
  { title: 'Filastudio’s Awesome Laravel', url: 'https://github.com/filastudio/awesome-laravel', description: t('A second directory with a dedicated Filament ecosystem section.', '另一份 Laravel 清单，专门整理了 Filament 生态。') },
  { title: 'Built with Laravel', url: 'https://builtwithlaravel.com/', description: t('A gallery of businesses and organizations that use Laravel.', '看看哪些企业与组织正在使用 Laravel。') },
] as const;
const practice: Partial<Record<typeof topics[number]['id'], { path: string; title: string }>> = {
  setup: { path: '/learn/', title: t('Build your first Laravel project', '做第一个 Laravel 项目') },
  data: { path: '/courses/api-access/', title: t('Practice API access with Sanctum', '动手练习 Sanctum 认证') },
  async: { path: '/courses/async-work/', title: t('Build and test a queued job', '编写并测试队列任务') },
  quality: { path: '/courses/automated-tests/', title: t('Write tests that catch regressions', '写出能发现回归的测试') },
  production: { path: '/courses/deploy-operate/', title: t('Rehearse a production release', '演练一次生产发布') },
};
---

<Base {title} {description}>
  <div class="shell">
    <DirectoryCover {title} {description} art="dependencies">
      <a class="text-link" href="#projects">{t(`Explore ${projects.length} open-source projects`, `阅读 ${projects.length} 个开源项目`)} <Icon name="right" size={16} /></a>
    </DirectoryCover>
    <div class="ecosystem-layout">
      <aside class="ecosystem-index">
        <nav aria-label={t('On this page', '本页目录')}>
          <p>{t('On this page', '本页目录')}</p>
          {topics.map(({ id, title }) => <a href={`#${id}`}><Icon name={topicGlyph[id]} size={16}/>{title}</a>)}
          <a href="#projects"><Icon name="repo" size={16}/>{t('Open-source projects', '开源项目')}</a>
          <a href="#quick-lab"><Icon name="test" size={16}/>{t('Queue challenge','队列挑战')}</a>
          <a href="#directories"><Icon name="books" size={16}/>{t('More directories', '更多资源清单')}</a>
        </nav>
      </aside>

      <div class="ecosystem-body">
        {topics.map(({ id, title, summary, resources }, index) => {
          const exercise = practice[id];
          return (
            <section class="topic topic-group" id={id} aria-labelledby={`topic-${id}`} tabindex="-1">
              <details class="topic-fold" open={index === 0}>
                <summary><h2 id={`topic-${id}`}><span>{title}</span><span class="fold-hint" aria-hidden="true">{resources.map((item) => item.name).join(' · ')}</span><span class="fold-sign" aria-hidden="true"></span></h2></summary>
                <p class="topic-summary">{summary}</p>
                <ul class="resource-rows" role="list">
                  {resources.map(({ id, url, name, description }) => (
                    <li class="saveable-choice" id={id} tabindex="-1"><a class="choice" href={url}><strong>{name}</strong><span>{description}</span><Icon name="external" size={17} /></a><SaveButton compact item={'/ecosystem/#' + id} name={name}/></li>
                  ))}
                </ul>
                {exercise && <a class="practice-link" href={href(exercise.path)}><span>{t('Free course', '免费课程')}</span>{exercise.title}<Icon name="right" size={16} /></a>}
              </details>
            </section>
          );
        })}

        <script is:inline>
          (() => {
            function openTopic(hash) {
              const target = document.getElementById(hash.slice(1));
              const fold = target?.closest('.topic-fold') ?? target?.querySelector('.topic-fold');
              if (fold) fold.open = true;
            }
            openTopic(location.hash);
            window.addEventListener('hashchange', () => openTopic(location.hash));
            document.querySelector('.ecosystem-index').addEventListener('click', (event) => {
              const link = event.target.closest('a[href^="#"]');
              if (link) openTopic(link.hash);
            });
          })();
        </script>

        <section class="topic projects" id="projects" aria-labelledby="projects-title" tabindex="-1">
          <header class="topic-heading">
            <h2 id="projects-title">{t('Open-source projects', '开源项目源码')}</h2>
            <p>{t('Start with one flow you can follow through the code. Source links point to the exact revisions reviewed here.', '从一段读得完的流程入手。源码链接固定在本文阅读时的版本。')}</p>
          </header>
          <ul class="project-grid" role="list">
            {projects.map((project) => (
              <li id={project.id} tabindex="-1" class="source-project" aria-labelledby={`project-${project.id}`}>
                <div class="project-meta">
                  <span>{project.topic}</span><SaveButton compact item={'/ecosystem/#' + project.id} name={project.name}/>
                  <span class="project-version">Laravel {project.framework}<a href={project.licenseUrl} aria-label={`${project.name} ${project.license} ${t('license', '许可证')}`}>{project.license}</a></span>
                </div>
                <h3 id={`project-${project.id}`}><a href={project.repositoryUrl}>{project.name} <Icon name="external" size={17} /></a></h3>
                <p>{project.description}</p>
                <a class="source-entry" href={project.sourceUrl}><Icon name="code" size={16} /><code>{project.entry}</code><Icon name="external" size={15} /></a>
              </li>
            ))}
          </ul>
        </section>

        <QuickLab id="queues"/>
        <section class="topic" id="directories" aria-labelledby="directories-title" tabindex="-1">
          <header class="topic-heading"><h2 id="directories-title">{t('More directories', '更多资源清单')}</h2></header>
          <ul class="resource-rows" role="list">
            {furtherReading.map(({ title, url, description }) => (
              <li><a class="choice" href={url}><strong>{title}</strong><span>{description}</span><Icon name="external" size={17} /></a></li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  </div>
</Base>

<style>
  .saveable-choice { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:4px; }
  .project-meta :global(.save-item) { width:32px; height:32px; min-height:32px; margin-right:auto; }

  .ecosystem-layout { display: grid; grid-template-columns: minmax(164px, .3fr) minmax(0, 1fr); gap: clamp(23px, 6vw, 90px); }
  .ecosystem-index { padding-top: clamp(24px, 5vw, 57px); }
  .ecosystem-index nav { position: sticky; top: 28px; display: grid; }
  .ecosystem-index p { color: var(--muted); padding-inline: 12px; margin: 0 0 8px; font: .79rem var(--mono); }
  .ecosystem-index a { display:flex; align-items:center; gap:9px; min-height: 40px; padding: 10px 12px; border-radius: var(--radius); color: var(--muted); font-size: .94rem; font-weight: 570; }
  .ecosystem-index a:hover { color: var(--accent); background: var(--accent-wash); }
  .topic { padding-top: clamp(32px, 4.4vw, 62px); scroll-margin-top: 12px; }
  .topic-group { padding-top: 0; border-bottom: 1px solid var(--line); }
  .topic-group:first-child { margin-top: clamp(24px, 4vw, 52px); }
  .topic-fold summary { display: block; cursor: pointer; padding-block: 18px; }
  .topic-fold summary::-webkit-details-marker { display: none; }
  .topic-fold h2 { display: grid; grid-template-columns: minmax(0, auto) minmax(0, 1fr) auto; align-items: center; gap: 16px; font:400 clamp(1.6rem,2.7vw,2.55rem)/1.15 var(--display); letter-spacing:-.025em; }
  .fold-hint { justify-self: end; color: var(--muted); font: .75rem/1.45 var(--mono); letter-spacing: 0; text-align: right; }
  .topic-fold[open] .fold-hint { visibility: hidden; }
  .fold-sign { display: grid; place-items: center; width: 29px; height: 29px; border: 1px solid var(--line-strong); border-radius: 0; }
  .fold-sign::before, .fold-sign::after { grid-area: 1 / 1; width: 11px; height: 1px; content: ''; background: currentColor; }
  .fold-sign::after { transform: rotate(90deg); transition: transform var(--transition); }
  .topic-fold[open] .fold-sign::after { transform: rotate(0); }
  .topic-fold summary:is(:hover, :focus-visible) .fold-sign { color: white; background: var(--ink); border-color: var(--ink); }
  .topic-summary { margin: -5px 0 14px; color: var(--muted); line-height: 1.55; }
  .topic-group:target summary h2 > span:first-child { color: var(--accent); }
  .topic-fold[open] { padding-bottom: 14px; }
  .topic:focus:not(:focus-visible), .source-project:focus:not(:focus-visible) { outline: none; }
  .topic-heading { margin-bottom: 15px; }
  .topic:target .topic-heading h2 { color: var(--accent); }
  .topic-heading h2 { font-size: clamp(1.8rem, 4vw, 3.1rem); font-weight: 520; letter-spacing: -.055em; }
  .topic-heading p { margin: 7px 0 0; color: var(--muted); line-height: 1.55; }
  .resource-rows, .project-grid { padding: 0; margin: 0; list-style: none; }
  .resource-rows { border-top: 1px solid var(--line-strong); }
  .resource-rows li { scroll-margin-top: 16px; }
  .resource-rows li:target .choice { background: var(--accent-wash); }
  .resource-rows li:focus:not(:focus-visible) { outline: none; }
  .choice { display: grid; grid-template-columns: minmax(102px, .31fr) minmax(0, 1fr) auto; align-items: start; column-gap: 17px; padding: 16px 10px 16px 0; border-bottom: 1px solid var(--line); }
  .choice strong { font-weight: 640; }
  .choice span { color: var(--muted); line-height: 1.55; font-size: .96rem; }
  .choice :global(svg) { margin-top: 2px; color: var(--accent); }
  .choice:hover { background: var(--wash); }
  .choice:hover strong { color: var(--accent); }
  .practice-link { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 7px; min-height: 44px; margin-top: 6px; color: var(--accent); font-size: .92rem; font-weight: 580; }
  .practice-link span { border-radius:var(--radius); padding: 4px 7px; background: var(--accent-wash); font-size: .77rem; }
  .practice-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .project-grid { display: grid; grid-template-columns:repeat(2,minmax(0,1fr)); column-gap:clamp(20px,3vw,40px); }
  .source-project { display: grid; grid-template-rows: auto auto 1fr auto; align-items: start; gap: 8px; padding:18px 0; border-top:1px solid var(--line-strong); background: var(--surface); scroll-margin-top: 18px; }
  .source-project:target { border-color: var(--accent); background: var(--accent-wash); }
  .project-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; color: var(--muted); font: .76rem var(--mono); }
  .project-version { display: inline-flex; align-items: center; gap: 9px; }
  .project-meta a { display: inline-flex; align-items: center; min-height: 30px; text-decoration: underline; text-underline-offset: 3px; }
  .source-project h3 { font-size: 1.45rem; font-weight: 620; letter-spacing: -.035em; }
  .source-project h3 a { display: inline-flex; align-items: center; gap: 6px; min-height: 34px; }
  .source-project h3 :global(svg), .source-entry { color: var(--accent); }
  .source-project p { margin: 0 0 5px; color: var(--muted); font-size: .94rem; line-height: 1.55; }
  .source-entry { display: flex; gap: 7px; align-items: center; min-height: 44px; border-top: 1px solid var(--line); font-size: .78rem; }
  .source-entry code { min-width: 0; flex: 1; overflow-wrap: anywhere; }
  .source-entry:hover, .source-project h3 a:hover { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 850px) {
    .ecosystem-layout { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .ecosystem-index nav { position: static; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px; }
    .ecosystem-index p { grid-column: 1 / -1; }
    .ecosystem-index a { border: 1px solid var(--line); }
  }
  @media (max-width: 560px) {
    .topic-fold h2 { grid-template-columns: minmax(0, 1fr) auto; }
    .fold-hint { display: none; }
    .ecosystem-index nav, .project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .choice { grid-template-columns: minmax(0, 1fr) auto; gap: 6px 10px; }
    .choice span { grid-column: 1 / -1; grid-row: 2; }
    .source-project { grid-column: 1 / -1; }
  }
</style>
