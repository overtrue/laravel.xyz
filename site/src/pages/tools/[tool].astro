---
import SaveButton from '../../components/SaveButton.astro';
import QuickLab from '../../components/QuickLab.astro';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { docs, getTools, type Tool } from '../../data/catalog';
import { getLocale, localize } from '../../lib/locale';
import '../../styles/workbench.css';

export function getStaticPaths() {
  return getTools('en').map((tool) => ({ params: { tool: tool.id }, props: { tool } }));
}

interface Props { tool: Tool }

const { tool } = Astro.props;
const { locale, t, href } = localize(getLocale(Astro.url.pathname));
const isEnv = tool.id === 'env-check';
const reference = { artisan: 'artisan', validation: 'validation', schedule: 'scheduling', 'env-check': 'configuration' }[tool.id];
const related = {
  artisan: {url:'/learn/first-project/#local-guide', label:t('Build a task list with Artisan','用 Artisan 建任务清单')},
  validation: {url:'/learn/form-validation/#try-it', label:t('Try the rules on a task form','在任务表单里试试验证规则')},
  schedule: {url:'/learn/schedule-task-reminders/', label:t('Run a scheduled reminder','动手运行定时提醒')},
  'env-check': {url:'/learn/verify-effective-config/', label:t('Check the settings Laravel actually uses','检查 Laravel 实际使用的配置')},
}[tool.id];
const types = [['string', t('String', '字符串')], ['email', t('Email', '邮箱')], ['integer', t('Integer', '整数')], ['numeric', t('Number', '数字')], ['boolean', t('Boolean', '布尔值')], ['date', t('Date', '日期')], ['array', t('Array', '数组')]];
const days = [t('Sunday', '周日'), t('Monday', '周一'), t('Tuesday', '周二'), t('Wednesday', '周三'), t('Thursday', '周四'), t('Friday', '周五'), t('Saturday', '周六')];
const copy = t('Copy', '复制');
---

<Base title={tool.title} description={tool.description}>
  <div class="shell">
    <header class="page-intro">
      <nav class="breadcrumbs" aria-label={t('Breadcrumb', '面包屑')}><Icon name={tool.icon} size={18}/><a href={href('/tools/')}>{t('Toolbox', '工具箱')}</a><Icon name="chevron" size={15} /><span>{tool.label}</span></nav>
      <h1>{tool.title}</h1><p>{tool.description}</p><div class="tool-save"><SaveButton item={'/tools/' + tool.id + '/'} name={tool.title}/></div>
    </header>

    <div class="workbench" data-tool={tool.id}>
      <section class="settings" aria-labelledby="settings-title">
        <h2 id="settings-title">{isEnv ? t('Configuration', '待检查的配置') : t('Options', '生成设置')}</h2>

        {tool.id === 'artisan' && (
          <div class="fields">
            <label>{t('Resource type', '资源类型')}
              <select name="resource-type">
                <option value="model">{t('Model', 'Model · 模型')}</option><option value="controller">{t('Controller', 'Controller · 控制器')}</option>
                <option value="request">{t('Form request', 'Form Request · 表单请求')}</option><option value="job">{t('Job', 'Job · 队列任务')}</option>
                <option value="migration">{t('Migration', 'Migration · 数据库迁移')}</option><option value="seeder">{t('Seeder', 'Seeder · 数据填充')}</option>
                <option value="test">{t('Test', 'Test · 测试')}</option>
              </select>
            </label>
            <label><span data-resource-label>{t('Class name', '类名')}</span><input name="resource-name" value="Task" maxlength="120" autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="resource-hint" /></label>
            <p id="resource-hint" class="hint" data-resource-hint>{t('Use a slash for a subdirectory, e.g. Admin/Task.', '可用斜杠指定子目录，如 Admin/Task。')}</p>
            <fieldset data-flags="model"><legend>{t('Also generate', '同时生成')}</legend>
              <label class="check"><input type="checkbox" value="--migration" checked /> Migration</label>
              <label class="check"><input type="checkbox" value="--factory" /> Factory</label>
              <label class="check"><input type="checkbox" value="--seed" /> Seeder</label>
              <label class="check"><input type="checkbox" value="--controller" /> Controller</label>
            </fieldset>
            <fieldset data-flags="controller" hidden><legend>{t('Controller options', '控制器选项')}</legend><label class="check"><input type="checkbox" value="--resource" /> {t('CRUD resource methods', 'CRUD 资源方法')}</label></fieldset>
            <fieldset data-flags="test" hidden><legend>{t('Test type', '测试类型')}</legend><label class="check"><input type="checkbox" value="--unit" /> {t('Unit test', '单元测试')}</label></fieldset>
          </div>
        )}

        {tool.id === 'validation' && (
          <div class="fields">
            <div class="field-actions" role="group" aria-label={t('Example forms', '示例表单')}>
              <button class="button" type="button" data-preset="task">{t('Task form', '任务表单')}</button>
              <button class="button" type="button" data-preset="contact">{t('Contact information', '联系信息')}</button>
            </div>
            <div class="rule-fields" data-rule-fields></div>
            <template id="rule-field">
              <fieldset class="rule-field">
                <legend data-legend>{t('Field', '字段')}</legend>
                <div class="field-pair">
                  <label>{t('Field name', '字段名')}<input data-field="name" placeholder={t('e.g. title', '如 title')} autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="90" /></label>
                  <label>{t('Type', '类型')}<select data-field="type">{types.map(([value, label]) => <option value={value}>{label}</option>)}</select></label>
                </div>
                <div class="field-pair" data-limits>
                  <label>{t('Minimum', '最小值')}<input data-field="min" type="number" inputmode="numeric" min="0" max="1000000" step="1" placeholder={t('Optional', '可选')} /></label>
                  <label>{t('Maximum', '最大值')}<input data-field="max" type="number" inputmode="numeric" min="0" max="1000000" step="1" placeholder={t('Optional', '可选')} /></label>
                </div>
                <div class="field-actions">
                  <label class="check"><input data-field="required" type="checkbox" checked /> {t('Required', '必填')}</label>
                  <button class="remove-rule" type="button" data-remove-rule>{t('Remove', '删除')}</button>
                </div>
              </fieldset>
            </template>
            <button class="button" type="button" data-add-rule>{t('Add field', '添加字段')}</button>
          </div>
        )}

        {tool.id === 'schedule' && (
          <div class="fields">
            <label>{t('Artisan command name', 'Artisan 命令名')}<input name="schedule-command" value="reports:daily" autocomplete="off" maxlength="80" spellcheck="false" aria-describedby="command-hint" /></label>
            <p id="command-hint" class="hint">{t('Enter the command name, e.g. reports:daily.', '填命令名，例如 reports:daily。')}</p>
            <div class="field-pair">
              <label>{t('Frequency', '频率')}<select name="frequency"><option value="daily">{t('Daily', '每天')}</option><option value="weekly">{t('Weekly', '每周')}</option><option value="hourly">{t('Hourly', '每小时')}</option><option value="five">{t('Every 5 minutes', '每 5 分钟')}</option></select></label>
              <label data-run-time>{t('Time', '执行时间')}<input type="time" name="run-time" value="09:00" /></label>
            </div>
            <label data-run-day hidden>{t('Day of week', '星期')}<select name="day">{[1, 2, 3, 4, 5, 6, 0].map((index) => <option value={index}>{days[index]}</option>)}</select></label>
            <label>{t('Scheduler time zone', 'Scheduler 时区')}<select name="timezone"><option selected={locale === 'en'}>UTC</option><option selected={locale === 'zh'}>Asia/Shanghai</option><option>Asia/Tokyo</option><option>Europe/London</option><option>America/New_York</option></select></label>
          </div>
        )}

        {isEnv && (
          <div class="fields">
            <label><span class="sr-only">{t('.env contents', '.env 内容')}</span><textarea id="env-content" rows="11" maxlength="120000" placeholder={t('Paste your configuration here…', '把要检查的配置粘贴到这里…')} autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="env-hint"></textarea></label>
            <p id="env-hint" class="hint"><Icon name="shield" size={15} /> {t('Your input stays in this browser.', '输入留在本机，检查后可以一键清空。')}</p>
            <div class="field-actions"><button class="button primary" type="button" data-run-check>{t('Check configuration', '检查配置')}</button><button class="button" type="button" data-env-demo>{t('Try an example', '填入示例')}</button><button class="button" type="button" data-env-clear>{t('Clear', '清空')}</button></div>
          </div>
        )}
      </section>

      <section class="result" aria-labelledby="result-title">
        <div class="result-header"><h2 id="result-title">{isEnv ? t('Results', '检查结果') : t('Output', '生成结果')}</h2>
          {!isEnv && <button type="button" class="result-copy" data-copy="tool-result" aria-live="polite" disabled><Icon name="copy" size={15} /> <span data-copy-caption>{copy}</span></button>}
        </div>
        {isEnv ? (
          <div class="env-result"><p id="env-status" aria-live="polite">{t('Paste your settings, then select Check configuration.', '输入配置后点击「检查配置」。')}</p><ul id="env-findings"></ul></div>
        ) : (
          <div class="code-result">
            <pre tabindex="0" aria-label={t('Generated code or command', '生成的代码或命令')}><code id="tool-result"></code></pre>
            <p id="tool-status" role="status" hidden></p>
          </div>
        )}

        {tool.id === 'schedule' && (
          <div class="cron-result">
            <div class="result-header"><h2>{t('Cron expression', 'Cron 表达式')}</h2><button type="button" class="result-copy" data-copy="cron-result" aria-live="polite" disabled><Icon name="copy" size={15} /> <span data-copy-caption>{copy}</span></button></div>
            <pre tabindex="0" aria-label={t('Generated cron expression', '生成的 Cron 表达式')}><code id="cron-result"></code></pre>
            <p>{t('Cron uses the system scheduler’s time zone. For Laravel Scheduler, place the generated PHP in', 'Cron 表达式按系统调度器的时区执行。使用 Laravel Scheduler 时，把上方代码放进')} <code>routes/console.php</code>{t('.', '。')}</p>
          </div>
        )}
        {tool.id === 'artisan' && <p class="result-note">{t('Run this from your project directory after installing dependencies. To check available model flags, use', '在已安装依赖的项目根目录运行。可用')} <code>php artisan help make:model</code>{t('.', '核对当前版本的参数。')}</p>}
        {tool.id === 'validation' && <p class="result-note">{t('Return this array from your form request’s', '把数组放入 Form Request 的')} <code>rules()</code>{t(' method. Limits count characters for strings and items for arrays.', '。字符串的范围指字符数，数组的范围指元素数。')}</p>}
        {isEnv && <p class="result-note">{t('Check the effective runtime settings, permissions, and configuration cache before deploying.', '此处检查常见配置。上线前仍要核对实际运行环境、权限和配置缓存。')}</p>}
      </section>
    </div>
    <noscript><p>{t('Enable JavaScript to use this tool locally.', '启用 JavaScript 后即可在本机使用此工具。')}</p></noscript>

    <div class="tool-links"><a class="text-link" href={href(related.url)}>{related.label} <Icon name="right" size={16} /></a><a class="text-link" href={`${docs}/${reference}`}>{t('Official documentation', '查看官方文档')} <Icon name="external" size={16} /></a></div>
    {(tool.id === 'artisan' || tool.id === 'validation') && <div class="workbench-lab"><QuickLab id={tool.id}/></div>}
  </div>
</Base>
<style>.tool-save { margin-top:12px; } .workbench-lab { margin-top:clamp(28px,4vw,50px); }</style>

<script>
  import '../../scripts/workbench';
</script>
