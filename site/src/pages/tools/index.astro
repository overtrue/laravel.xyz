---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import SaveButton from '../../components/SaveButton.astro';
import QuickLab from '../../components/QuickLab.astro';
import DirectoryCover from '../../components/DirectoryCover.astro';
import { getTools } from '../../data/catalog';
import { getLocale, localize } from '../../lib/locale';

const { locale, t, href } = localize(getLocale(Astro.url.pathname));
const tools = getTools(locale);
const title = t('Laravel toolbox', 'Laravel 工具箱');
const description = t('Build commands, rules, and schedules. All input stays in your browser.', '生成命令、验证规则和计划任务。所有输入都在当前浏览器里处理。');
---

<Base {title} {description}>
  <div class="shell">
    <DirectoryCover {title} {description} art="instruments"><a class="text-link" href="#quick-lab"><Icon name="test" size={16}/>{t('Try the Artisan challenge','试试 Artisan 挑战')}</a></DirectoryCover>
    <ul class="tool-directory">
      {tools.map((tool) => (
        <li><a href={href(`/tools/${tool.id}/`)}>
          <span class="icon-tile"><Icon name={tool.icon} size={23} /></span>
          <h2>{tool.title}</h2><p>{tool.description}</p>
          <Icon name="right" size={21} />
        </a><SaveButton compact item={'/tools/' + tool.id + '/'} name={tool.title}/></li>
      ))}
    </ul>
    <div class="tool-lab"><QuickLab id="artisan"/></div>
  </div>
</Base>

<style>
  .tool-directory { list-style:none; margin:clamp(20px,3vw,42px) 0 0; padding:0; border-block:1px solid var(--line-strong); }
  .tool-lab { margin-top:clamp(34px,5vw,66px); }
  .tool-directory li { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:8px; }
  .tool-directory li+li { border-top:1px solid var(--line); }
  .tool-directory a { display:grid; grid-template-columns:48px minmax(170px,.8fr) minmax(0,1fr) 22px; align-items:center; gap:clamp(12px,2vw,32px); padding:clamp(17px,2.6vw,34px) 4px; }
  .tool-directory h2 { font:400 clamp(1.55rem,2.5vw,2.3rem)/1.12 var(--display); letter-spacing:-.025em; }
  .tool-directory p { color:var(--muted); margin:0; font-size:.95rem; line-height:1.5; }
  .tool-directory .icon-tile { width:42px; height:42px; }
  .tool-directory a:hover { background:var(--wash); }
  .tool-directory a:hover h2 { color:var(--accent); }
  @media(max-width:640px) {
    .tool-directory a { grid-template-columns:36px minmax(0,1fr) 20px; row-gap:3px; }
    .tool-directory a>span { grid-row:1 / 3; } .tool-directory .icon-tile { width:34px; height:38px; }
    .tool-directory p { grid-column:2; font-size:.88rem; } .tool-directory a>:global(svg) { grid-column:3; grid-row:1 / 3; }
  }
</style>
